# Local PostgreSQL via docker-compose
DATABASE_URL=postgresql://scuser:scpass@localhost:5432/supply_chain
DB_HOST=localhost
DB_PORT=5432
DB_NAME=supply_chain
DB_USER=scuser
DB_PASSWORD=scpass

RANDOM_SEED=42
N_SUPPLIERS=60
N_PARTS=600
N_BOM_RELATIONSHIPS=1200
N_PURCHASE_ORDERS=55000
N_INVENTORY_RECORDS=110000
N_SALES_ORDERS=55000

MODEL_DIR=models
DELAY_MODEL_NAME=supplier_delay_xgb.joblib
STOCKOUT_MODEL_NAME=stockout_risk_xgb.joblib
LOG_LEVEL=INFO
ENVIRONMENT=development
